#!/usr/bin/env bash
# Run one handoff thread in an interactive claude session in the current
# tmux pane, with a small driver pane below it.
# When the context-budget notice fires, write the handoff, clear, and
# read it back.
# Usage: hq loop [--max-cycles N] <slug>
#        hq loop stop <slug>   (write the next handoff, then end the loop)
# hq loop runs this script at the project root.

set -euo pipefail

# read -t returns a status above 128 on a timeout only from bash 4 on.
((BASH_VERSINFO[0] >= 4)) || { echo "hq loop: needs bash 4 or later" >&2; exit 1; }

TICK_SECS=5
DEBOUNCE=2
EXIT_TIMEOUT=20
RETRY_CAP=2
AGENT_CAP=500
# The hook reads a prompt that ends on TAIL as the driver's own line,
# so it never becomes a stall ruling.
TAIL="The loop driver typed this line. It answers no question. If a security or stability question is still open, end on it again, as the last line, with ? as the last character."
NUDGE_TEXT="Take the next workable step now. A finished step does not end the turn. When nothing is workable and the thread waits on a file or a job, start a background monitor on it with a timeout of ten minutes or more, unless one runs. Otherwise make no tool call. Then say in one line, ending on a period, what the thread waits on, or that every Plan item is done, and end the turn. $TAIL"
RETRY_TEXT="hq finish did not pass, and this session still holds the handoff lock. Read the message hq finish printed, fix what it names, and run hq finish again. Pass --replace-directives only when the user has said so in this session. Otherwise restore the Directives section. $TAIL"
BUDGET_STATE_DIR="$HOME/.claude/cache/claude-handoff"

die() {
    echo "hq loop: $*" >&2
    exit 1
}

# One short line per event is a single O_APPEND write, so the driver
# never reads half a line. A field never prints empty, because read
# would collapse it. A monitor lists as type shell, so neither counts
# as a task that keeps the session busy.
hook() {
    local dir=$1 payload event slug ruling
    payload=$(cat)
    jq -r '[.hook_event_name,
            (if .hook_event_name == "PostToolUse"
             then ((.agent_id | strings | select(. != "")) // "main")
             else ([.source, .error, .notification_type]
                   | map(select(. != null and . != "")) | first // "-") end),
            (.session_id // "-"),
            ([.background_tasks | arrays | .[]
              | select(.type != "monitor" and .type != "shell")] | length),
            (if ((.last_assistant_message | strings) // "") | test("[?]\\s*$")
             then 1 else 0 end)
           ] | map(tostring) | join(" ")' <<<"$payload" >>"$dir/events" || true
    event=$(jq -r '.hook_event_name // ""' <<<"$payload" 2>/dev/null) || exit 0
    slug=$(cat "$dir/slug" 2>/dev/null) || slug=
    case $event in
        Stop)
            jq -r '(.last_assistant_message | strings) // ""
                   | [splits("\n") | select(test("\\S"))] | last // ""
                   | .[:160]' <<<"$payload" >"$dir/last" || true
            ;;
        SessionStart)
            awk -F'\t' 'NR > 1 && NF { c = $1 } END { print c + 0 }' \
                "${HQ_ROOT:-.}/.handoff/$slug/cycles/manifest.tsv" \
                >"$dir/mark" 2>/dev/null || echo 0 >"$dir/mark"
            ;;
        # The driver types only lines that start with / or end on the
        # Tail, and a task's event or a teammate's message opens on its
        # tag. Any other prompt is the user's or a peer's, and the first
        # one after the hold is its ruling.
        UserPromptSubmit)
            [[ -e $dir/hold && ! -e $dir/ruling ]] || exit 0
            ruling=$(jq -r --arg tail "$TAIL" '
                (.prompt | strings) // "" | sub("^\\s+"; "") | sub("\\s+$"; "")
                | if startswith("/") or startswith("<task-notification>")
                     or startswith("<agent-message") or endswith($tail)
                  then "skip"
                  else "rule " + ((split("\n") | first // "")[:160]) end
                ' <<<"$payload") || exit 0
            [[ $ruling == rule\ * ]] || exit 0
            printf '%s\n' "${ruling#rule }" >"$dir/ruling"
            jq -n --arg c "This prompt ends the hold. Act on it by the loop rule, then run /handoff write $slug." \
                '{hookSpecificOutput:
                  {hookEventName: "UserPromptSubmit", additionalContext: $c}}'
            ;;
    esac
    exit 0
}

drive() {
    local dir=$1 slug=$2 max=$3 target=$4 launcher=$5
    local folder=".handoff/$slug"
    local event src sid='' ev_sid tasks endsq rc wait_secs due
    local launch_cycle base turn=0 tools=0 dialog=0 sent=-1 retries=0
    local stop_sent=0 compacts=0 agent_calls=0 park=''
    local stop_tasks=0 stop_endsq=0 read_due=0 stop_due=0 tick_due

    # The trap runs after this function returns, when its locals are gone.
    # shellcheck disable=SC2064
    trap "rm -rf -- $(printf %q "$dir")" EXIT
    # finish removes $dir while tail still follows the file.
    exec 3< <(tail -n +1 -F "$dir/events" 2>/dev/null)

    # The loop ends with the launcher, which a SIGKILL leaves no chance
    # to close this pane.
    alive() { tmux list-panes -t "$target" >/dev/null 2>&1 && kill -0 "$launcher" 2>/dev/null; }

    say() {
        printf '\e[2m%s\e[0m [%d/%d] \e[2m%s\e[0m\n' \
            "$(date +%H:%M)" "$((base - launch_cycle + 1))" "$max" "$1"
    }

    # tmux shows the bell's ! flag on a loop window that is not the
    # session's current window. The display message shows only to a
    # client attached now. The bell goes to stderr, the same terminal,
    # so stdout holds only said lines.
    alert() {
        say "$1"
        printf '\a' >&2
        tmux display-message -d 10000 -t "$target" "hq loop $slug: $1" || true
    }

    # The launcher waits on claude alone, so it stands for claude.
    launcher_gone_within() {
        local deadline=$((SECONDS + $1))
        while kill -0 "$launcher" 2>/dev/null; do
            ((SECONDS < deadline)) || return 1
            sleep 0.5
        done
    }

    descendants() {
        local pid
        for pid in $(pgrep -P "$1" || true); do
            echo "$pid"
            descendants "$pid"
        done
    }

    # END. launch prints the reason from $dir/end, rings, closes this
    # pane and removes $dir.
    finish() {
        local reason=$1 deadline quiet_due=$SECONDS rc
        printf '%s\n' "$reason" >"$dir/end"
        say "$reason"
        deadline=$((SECONDS + EXIT_TIMEOUT))
        while ((turn || dialog || SECONDS < quiet_due)) && ((SECONDS < deadline)); do
            rc=0
            read -r -t 1 -u 3 event src ev_sid tasks endsq _ || rc=$?
            ((rc > 128)) && continue
            ((rc == 0)) || break
            if [[ $event == SessionStart ]]; then
                sid=$ev_sid
            elif [[ $ev_sid != "$sid" ]]; then
                continue
            fi
            case $event in
                Stop | StopFailure) turn=0 ;;
                SessionStart) turn=0 dialog=0 ;;
                UserPromptSubmit) turn=1 dialog=0 ;;
                PostToolUse)
                    [[ $src == main ]] || continue
                    turn=1 dialog=0
                    ;;
                Notification) if is_dialog "$src"; then dialog=1; fi ;;
            esac
            quiet_due=$((SECONDS + DEBOUNCE + 1))
        done
        if ((turn == 0 && dialog == 0 && SECONDS >= quiet_due)); then
            send_line /exit || true
            sleep "$DEBOUNCE"
            # A running background task makes /exit open a dialog, and
            # Enter takes its default, Exit and stop tasks.
            if kill -0 "$launcher" 2>/dev/null; then
                tmux send-keys -t "$target" Enter || true
            fi
        fi
        launcher_gone_within "$EXIT_TIMEOUT" && exit 0
        # shellcheck disable=SC2046
        kill -TERM $(descendants "$launcher") 2>/dev/null || true
        launcher_gone_within "$EXIT_TIMEOUT" && exit 0
        # shellcheck disable=SC2046
        kill -KILL $(descendants "$launcher") 2>/dev/null || true
        # launch still needs $dir/end once claude exits.
        if ! launcher_gone_within "$DEBOUNCE"; then
            trap - EXIT
            alert "$reason. claude did not exit: close it by hand"
        fi
        exit 0
    }

    is_dialog() {
        case $1 in
            permission_prompt | worker_permission_prompt | \
                elicitation_dialog | \
                elicitation_url_dialog | agent_needs_input) return 0 ;;
        esac
        return 1
    }

    # A mouse scroll leaves the pane in copy mode, which swallows every
    # key sent to it. In vim editing mode, i returns the box to insert
    # mode. Elsewhere it types one letter that C-u removes with the rest
    # of the line. C-e first, because C-u keeps any text after the
    # cursor. Enter follows after a pause so the slash-command menu has
    # closed.
    send_line() {
        tmux copy-mode -q -t "$target" &&
            tmux send-keys -t "$target" i C-e C-u &&
            tmux send-keys -t "$target" -l -- "$1" &&
            sleep 0.3 &&
            tmux send-keys -t "$target" Enter
    }

    type_line() {
        ((turn == 0 && dialog == 0)) || return 1
        if ! send_line "$1"; then
            park_with type alert "could not type into the claude pane"
            return 1
        fi
        turn=1
    }

    # finish appends a manifest row after it writes HANDOFF.md and
    # before it removes .hq.lock, so this advances once per finished
    # cycle. The Cycle field in HANDOFF.md repeats a number on a thread
    # whose first cycle is still open.
    thread_cycle() {
        [[ -f $folder/cycles/manifest.tsv ]] || { echo 0; return; }
        awk -F'\t' 'NR > 1 && NF { c = $1 } END { print c + 0 }' \
            "$folder/cycles/manifest.tsv"
    }

    # A park acts once, so a repeat of the same park stays silent.
    park_with() {
        [[ $park == "$1" ]] && return 0
        park=$1
        "$2" "$3"
    }

    # The marker file's mtime is the last bell, so a rewritten hold
    # rings again even when its text repeats.
    ring_hold() {
        [[ $dir/hold -nt $dir/holdbell ]] || return 0
        touch "$dir/holdbell"
        alert "$slug holds: $(head -n 1 "$dir/hold")"
        return 0
    }

    type_write() {
        type_line "/handoff write $slug" || return 1
        sent=$((sent < 0 ? 0 : sent))
    }

    cycle_end() {
        local cycle=$1
        if [[ -e $dir/stop ]]; then
            finish "stopped after cycle $cycle as requested"
        fi
        if ((cycle - launch_cycle >= max)); then
            finish "reached --max-cycles $max at cycle $cycle"
        fi
        if ((stop_tasks > 0)); then
            return 0
        fi
        if type_line "/clear"; then
            say "cycle $cycle written, clearing"
        fi
        return 0
    }

    stop_decisions() {
        local last cycle lock_session budget band=-1
        last=$(cat "$dir/last" 2>/dev/null) || last=
        if [[ -e $folder/.hq.done ]]; then
            finish "$slug is marked done"
        fi
        if ((stop_endsq)); then
            park_with question alert "$slug asks: $last"
            return 0
        fi
        if [[ -e $folder/.hq.lock ]]; then
            lock_session=$(awk -F= '$1 == "session" { print $2; exit }' \
                "$folder/.hq.lock" 2>/dev/null) || lock_session=
            if [[ $lock_session == "$sid" ]]; then
                if ((retries < RETRY_CAP)); then
                    if type_line "$RETRY_TEXT"; then ((++retries)); fi
                else
                    park_with finish alert "hq finish has not passed after $retries retries"
                fi
            else
                park_with lock say "waits on the lock of $lock_session"
            fi
            return 0
        fi
        cycle=$(thread_cycle)
        if ((cycle > base)); then
            cycle_end "$cycle"
            return 0
        fi
        if [[ -e $dir/stop ]] && ((stop_sent == 0)); then
            if type_write; then stop_sent=1; fi
            return 0
        fi
        # The budget hook runs beside this one, so its state file can
        # lag the Stop. DEBOUNCE leaves it time to settle.
        budget=$(jq -r '.band // -1' "$BUDGET_STATE_DIR/$sid.json" 2>/dev/null) ||
            budget=
        [[ $budget =~ ^-?[0-9]+$ ]] && band=$budget
        if ((band >= 0 && band > sent)); then
            if type_write; then sent=$band; fi
            return 0
        fi
        if ((sent >= 0)); then
            if ((retries < RETRY_CAP)); then
                if type_write; then ((++retries)); fi
            else
                park_with write alert "a write was typed $((retries + 1)) times and cycle $((base + 1)) is not written"
            fi
            return 0
        fi
        if [[ -e $dir/hold ]]; then
            if [[ -e $dir/ruling ]]; then
                type_write || true
            else
                park_with hold say "$(head -n 1 "$dir/hold")"
            fi
            return 0
        fi
        if ((tools > 0)); then
            type_line "$NUDGE_TEXT" || true
            return 0
        fi
        park_with waits say "$slug waits: $last"
        return 0
    }

    launch_cycle=$(thread_cycle)
    base=$launch_cycle

    tick_due=$((SECONDS + TICK_SECS))
    while alive; do
        wait_secs=$((tick_due - SECONDS))
        for due in "$read_due" "$stop_due"; do
            ((due > 0 && due - SECONDS < wait_secs)) && wait_secs=$((due - SECONDS))
        done
        ((wait_secs < 1)) && wait_secs=1
        rc=0
        read -r -t "$wait_secs" -u 3 event src ev_sid tasks endsq _ || rc=$?
        if ((rc > 128)); then
            event=-
        elif ((rc != 0)); then
            finish "event stream closed"
        else
            ring_hold
        fi

        # Another session's event still lets the due checks below run.
        if [[ $event == SessionStart ]]; then
            sid=$ev_sid
        elif [[ $ev_sid != "$sid" ]]; then
            event=-
        fi

        case $event in
            Stop)
                turn=0 park='' stop_tasks=$tasks stop_endsq=$endsq
                stop_due=$((SECONDS + DEBOUNCE + 1))
                ;;
            StopFailure)
                turn=0 stop_due=0 stop_tasks=$tasks stop_endsq=$endsq
                park_with error alert "claude stopped on an API error: $src"
                ;;
            UserPromptSubmit)
                turn=1 tools=0 dialog=0 park='' stop_due=0
                ;;
            PostToolUse)
                if [[ $src == main ]]; then
                    turn=1 dialog=0 stop_due=0
                    ((++tools))
                else
                    ((++agent_calls))
                    if ((agent_calls == AGENT_CAP)); then
                        alert "agents made $agent_calls tool calls in cycle $((base + 1)) with no write"
                    fi
                fi
                ;;
            SessionStart)
                park='' stop_due=0
                case $src in
                    startup | clear | resume)
                        turn=0 dialog=0
                        read_due=$((SECONDS + DEBOUNCE + 1))
                        # A clear the user types moves the base too, or
                        # the next Stop clears the fresh session again.
                        if [[ $src == clear ]]; then
                            base=$(thread_cycle) sent=-1 retries=0
                            compacts=0 agent_calls=0
                        fi
                        if [[ $src == startup ]]; then
                            say "started $slug at cycle $((base + 1))"
                        fi
                        ;;
                    compact)
                        ((++compacts))
                        if ((compacts == 2)); then
                            alert "compacted twice in cycle $((base + 1)) with no write"
                        fi
                        ;;
                esac
                ;;
            Notification)
                if is_dialog "$src"; then
                    dialog=1
                    alert "claude is waiting for you ($src)"
                fi
                if ((stop_due > 0)); then
                    stop_due=$((SECONDS + DEBOUNCE + 1))
                fi
                ;;
        esac

        if ((read_due > 0 && SECONDS >= read_due)); then
            read_due=0 turn=0
            type_line "/handoff read $slug" || true
        fi
        if ((stop_due > 0 && SECONDS >= stop_due)); then
            stop_due=0
            stop_decisions
        fi
        # The Stop decisions keep their order at a tick, so the Stop file
        # never writes over a question or past a written cycle. A pending
        # decision or read comes first.
        if ((SECONDS >= tick_due)); then
            tick_due=$((SECONDS + TICK_SECS))
            if ((turn == 0)); then
                ring_hold
            fi
            if ((turn == 0 && stop_due == 0 && read_due == 0)); then
                if [[ -e $folder/.hq.done ]]; then
                    finish "$slug is marked done"
                elif [[ -e $dir/stop && ! -e $folder/.hq.lock ]] &&
                    ((stop_sent == 0)); then
                    stop_decisions
                elif [[ $park == lock && ! -e $folder/.hq.lock ]]; then
                    park=''
                    stop_decisions
                fi
            fi
        fi
    done
}

launch() {
    local max=$1 slug=$2
    shift 2
    local claude_cmd=("$@")
    # tmux renames a session name that holds '.' or ':'.
    [[ $slug =~ ^[A-Za-z0-9_-]+$ ]] || die "slug takes letters, digits, '_' and '-'"
    [[ $max =~ ^[1-9][0-9]*$ ]] || die "--max-cycles takes a positive integer"
    for tool in tmux jq "${claude_cmd[0]}"; do
        command -v "$tool" >/dev/null || die "$tool is not on PATH"
    done
    [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]] || die "run hq loop inside a tmux pane"
    (($(tmux display-message -p -t "$TMUX_PANE" '#{pane_height}') >= 12)) ||
        die "the pane is too short for a driver pane below it"
    [[ -f .handoff/$slug/HANDOFF.md ]] ||
        die "no .handoff/$slug/HANDOFF.md here (give the exact folder name)"
    [[ ! -e .handoff/$slug/.hq.done ]] || die "$slug is marked done"
    [[ ! -e .handoff/$slug/.hq.lock ]] ||
        die "$slug has an open cycle (.hq.lock) - finish it in its session, or run hq begin $slug --force once that session is dead"
    awk '/^## / { in_dir = ($0 ~ /^## Directives[ \t]*$/); next }
        in_dir && /^- Loop \(user,/ { found = 1 }
        END { exit !found }' ".handoff/$slug/HANDOFF.md" ||
        die "$slug has no Loop directive - run /hq-loop $slug first"
    awk -F'\t' 'NR > 1 && $15 ~ /^[0-9]+$/ { found = 1 } END { exit !found }' \
        ".handoff/$slug/cycles/manifest.tsv" 2>/dev/null ||
        die "$slug has no cycle with a readable summary - run /hq-loop $slug to audit it"

    local self dir hook_cmd notice notice_cmd dpane running rc=0
    running=$(tmux list-panes -a -F '#{@hqloop_slug}')
    grep -qx -- "$slug" <<<"$running" && die "a loop for $slug is already running"

    self=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
    # hq loop starts this script at the root it resolved, which can
    # differ from the git top level that hq falls back to.
    export HQ_ROOT=$PWD
    dir=$(mktemp -d)
    export HQ_LOOP=$dir
    : >"$dir/events"
    printf '%s\n' "$slug" >"$dir/slug"
    # A plugin update removes the versioned path, so the notice hook
    # exits quietly once its script is gone.
    notice=${self%/*}/../scripts/handoff_nudge.py
    printf -v notice_cmd '[ -f %q ] || exit 0; python3 %q' "$notice" "$notice"
    # The hook runs this script once per event, so a redeploy during the
    # run would pair a new hook with the old driver. Both run a copy,
    # and the hook exits quietly once the driver has removed it.
    cp "$self" "$dir/hq-loop"
    chmod u+x "$dir/hq-loop"
    self=$dir/hq-loop
    printf -v hook_cmd '[ -x %q ] || exit 0; %q hook %q' "$self" "$self" "$dir"
    jq -n --arg c "$hook_cmd" --arg n "$notice_cmd" '
        {hooks: {
            Stop: [{hooks: [{type: "command", command: $c}]}],
            StopFailure: [{hooks: [{type: "command", command: $c}]}],
            Notification: [{hooks: [{type: "command", command: $c}]}],
            UserPromptSubmit: [{hooks: [{type: "command", command: $c}]}],
            SessionStart: [{hooks: [{type: "command", command: $c}]}],
            PostToolUse: [{hooks: [{type: "command", command: $c},
                                   {type: "command", command: $n}]}]}}' \
        >"$dir/settings.json"

    # The driver types into this pane by id. A new pane takes the tmux
    # server's environment, so PATH, HOME and HQ_ROOT go in by hand.
    # Its own pane carries the slug and temp dir for hq loop stop to
    # find.
    dpane=$(tmux split-window -d -P -F '#{pane_id}' -l 5 -t "$TMUX_PANE" \
        -e "PATH=$PATH" -e "HOME=$HOME" -e "HQ_ROOT=$HQ_ROOT" \
        "$self" drive "$dir" "$slug" "$max" "$TMUX_PANE" "$$") || {
        rm -rf -- "$dir"
        die "could not split the pane for the driver"
    }
    # shellcheck disable=SC2064
    trap "close_launch $(printf %q "$dpane") $(printf %q "$dir")" EXIT HUP TERM
    tmux set-option -p -t "$dpane" @hqloop_slug "$slug"
    tmux set-option -p -t "$dpane" @hqloop_dir "$dir"

    "${claude_cmd[@]}" --settings "$dir/settings.json" || rc=$?
    exit "$rc"
}

# After a TERM or HUP runs this, the EXIT trap runs it again, so only
# the first run may find $dir.
close_launch() {
    local dpane=$1 dir=$2
    if [[ -s $dir/end ]]; then
        printf 'hq loop: %s\n' "$(cat "$dir/end")" || true
        printf '\a' >&2 || true
    fi
    tmux kill-pane -t "$dpane" 2>/dev/null || true
    rm -rf -- "$dir"
}

# The flag takes effect at the session's next Stop or rest tick, when
# the driver next looks. Zooming the claude pane hides the driver pane
# and its messages.
stop() {
    local slug=${1:-} dir panes
    [[ $slug =~ ^[A-Za-z0-9_-]+$ ]] || die "usage: hq loop stop <slug>"
    panes=$(tmux list-panes -a -F '#{@hqloop_slug} #{@hqloop_dir}')
    dir=$(awk -v s="$slug" '$1 == s { print $2; exit }' <<<"$panes")
    [[ -n $dir && -d $dir ]] || die "no running hq loop for $slug"
    touch "$dir/stop"
    echo "hq loop: stop requested. The loop writes the handoff at the next Stop or rest tick, then ends."
}

case "${1:-}" in
    hook) hook "$2" ;;
    stop) stop "$2" ;;
    drive) shift; drive "$@" ;;
    launch) shift; launch "$@" ;;
    *) die "run this as hq loop" ;;
esac
